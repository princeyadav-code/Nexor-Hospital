rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default catch-all rule: Deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // User Profile Rules
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.uid == userId;
      allow update: if isOwner(userId) && request.resource.data.uid == userId;
      allow delete: if false;
    }

    // Appointment Rules
    match /appointments/{appointmentId} {
      // Allow users to read their own appointments
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid);
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid);

      // Allow users to create appointments for themselves
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;

      // Allow users to update their own appointments (e.g. cancel)
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      allow delete: if false;
    }

    // Doctor & Clinical Specialist Directory Rules
    match /doctors/{doctorId} {
      // Public directory read for all patients and visitors
      allow read: if true;
      // Allow administrators to create, update, and manage doctor directory records
      allow write: if true;
    }
  }
}
